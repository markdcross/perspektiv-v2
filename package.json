{
  "name": "perspektiv-v2",
  "version": "1.0.0",
  "description": "Perspektiv v2.0",
  "main": "server.js",
  "scripts": {
    "start": "NODE_ENV=production node server",
    "server": "nodemon server",
    "dev": "concurrently \"nodemon --ignore 'client/*'\" \"npm run client\"",
    "client": "cd client && npm run start",
    "client:build": "cd client && npm run build",
    "test": "node --test test/*.test.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markdcross/perspektiv-v2.git"
  },
  "author": "Mark Cross, Danny Fraley, Roberto Rubet, and Josh Allen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/markdcross/perspektiv-v2/issues"
  },
  "homepage": "https://github.com/markdcross/perspektiv-v2#readme",
  "dependencies": {
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "colors": "^1.4.0",
    "compression": "^1.8.1",
    "config": "^3.3.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.0.2",
    "express-rate-limit": "^5.2.3",
    "express-validator": "^6.9.2",
    "gravatar": "^1.8.1",
    "helmet": "^4.4.1",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "morgan": "^1.10.1",
    "multer": "^2.3.0",
    "node-geocoder": "^4.4.1",
    "nodemailer": "^10.0.2",
    "slugify": "^1.4.6",
    "xss-clean": "^0.1.1"
  },
  "devDependencies": {
    "concurrently": "^5.3.0",
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
